out = fwm-dock
src = src/dock.c src/text.c

cflags += $(ft_cflags) $(lua_cflags) $(xcb_cflags)
ldflags += $(ft_libs) $(lua_libs) $(xcb_libs)

.PHONY: FORCE

$(target): FORCE
	$(cc) -o bin/$(out) $(src) $(cflags) $(ldflags)

install: FORCE
	@unlink $(basedir)/bin/$(out); \
	cp -v bin/$(out) $(basedir)/bin/; \

clean:
	-rm -f bin/$(out)
